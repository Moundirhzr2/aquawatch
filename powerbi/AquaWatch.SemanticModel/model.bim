            "sourceColumn": "title",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fct_cases",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = Csv.Document(File.Contents(DataFolder & \"/fct_cases.csv\"), [Delimiter=\",\", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "  Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "  EmptyToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "  Typed = Table.TransformColumnTypes(EmptyToNull, {{\"case_id\", type text}, {\"meter_id\", type text}, {\"kind\", type text}, {\"event_date\", type date}, {\"severity\", type text}, {\"status\", type text}, {\"amount_cents\", Int64.Type}, {\"version\", Int64.Type}, {\"title\", type text}}, \"en-US\")",
                "in",
                "  Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Active investigations",
            "expression": "CALCULATE(COUNTROWS(fct_cases), fct_cases[status] IN {\"open\", \"investigating\"})",
            "formatString": "#,0",
            "description": "Synthetic demonstration; see docs/metric-definitions.md for grain and limitations."
          },
          {
            "name": "Case count",
            "expression": "COUNTROWS(fct_cases)",
            "formatString": "#,0",
            "description": "Synthetic demonstration; see docs/metric-definitions.md for grain and limitations."
          },
          {
            "name": "Active amount to review EUR",
            "expression": "DIVIDE(CALCULATE(SUM(fct_cases[amount_cents]), fct_cases[status] IN {\"open\", \"investigating\"}), 100)",
            "formatString": "€ #,0.00",
            "description": "Synthetic demonstration; see docs/metric-definitions.md for grain and limitations."
          }
        ]
      },
      {
        "name": "fct_imports",
