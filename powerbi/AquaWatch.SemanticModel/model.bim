            "summarizeBy": "none"
          },
          {
            "name": "tariff_id",
            "dataType": "string",
            "sourceColumn": "tariff_id",
            "summarizeBy": "none"
          },
          {
            "name": "period_start",
            "dataType": "dateTime",
            "sourceColumn": "period_start",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "period_end",
            "dataType": "dateTime",
            "sourceColumn": "period_end",
            "summarizeBy": "none",
