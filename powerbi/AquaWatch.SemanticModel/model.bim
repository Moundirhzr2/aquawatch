{
  "name": "AquaWatch",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "dim_meters",
        "columns": [
          {
            "name": "meter_id",
            "dataType": "string",
            "sourceColumn": "meter_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_name",
            "dataType": "string",
            "sourceColumn": "customer_name",
            "summarizeBy": "none"
          },
          {
            "name": "district",
            "dataType": "string",
            "sourceColumn": "district",
            "summarizeBy": "none"
          },
          {
            "name": "segment",
            "dataType": "string",
            "sourceColumn": "segment",
            "summarizeBy": "none"
          },
          {
            "name": "installed_on",
            "dataType": "dateTime",
            "sourceColumn": "installed_on",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          }
        ],
        "partitions": [
          {
            "name": "dim_meters",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = Csv.Document(File.Contents(DataFolder & \"/dim_meters.csv\"), [Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "  Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "  EmptyToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "  Typed = Table.TransformColumnTypes(EmptyToNull, {{\"meter_id\", type text}, {\"customer_id\", type text}, {\"customer_name\", type text}, {\"district\", type text}, {\"segment\", type text}, {\"installed_on\", type date}}, \"en-US\")",
                "in",
                "  Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Connected meters",
            "expression": "DISTINCTCOUNT(dim_meters[meter_id])",
            "formatString": "#,0",
            "description": "Synthetic demonstration; see docs/metric-definitions.md for grain and limitations."
          }
        ]
      },
      {
        "name": "dim_date",
        "columns": [
          {
            "name": "calendar_date",
            "dataType": "dateTime",
            "sourceColumn": "calendar_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "year_number",
            "dataType": "int64",
            "sourceColumn": "year_number",
            "summarizeBy": "none"
          },
          {
            "name": "month_number",
            "dataType": "int64",
            "sourceColumn": "month_number",
            "summarizeBy": "none"
          },
          {
            "name": "day_number",
            "dataType": "int64",
            "sourceColumn": "day_number",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = Csv.Document(File.Contents(DataFolder & \"/dim_date.csv\"), [Delimiter=\",\", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "  Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "  EmptyToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "  Typed = Table.TransformColumnTypes(EmptyToNull, {{\"calendar_date\", type date}, {\"year_number\", Int64.Type}, {\"month_number\", Int64.Type}, {\"day_number\", Int64.Type}}, \"en-US\")",
                "in",
                "  Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "fct_consumption",
        "columns": [
          {
            "name": "reading_id",
            "dataType": "string",
            "sourceColumn": "reading_id",
            "summarizeBy": "none"
          },
          {
            "name": "meter_id",
            "dataType": "string",
            "sourceColumn": "meter_id",
            "summarizeBy": "none"
          },
          {
            "name": "reading_date",
            "dataType": "dateTime",
            "sourceColumn": "reading_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "counter_liters",
            "dataType": "int64",
            "sourceColumn": "counter_liters",
            "summarizeBy": "none"
          },
          {
            "name": "previous_counter_liters",
            "dataType": "int64",
            "sourceColumn": "previous_counter_liters",
            "summarizeBy": "none"
          },
          {
            "name": "interval_days",
            "dataType": "int64",
            "sourceColumn": "interval_days",
            "summarizeBy": "none"
          },
          {
            "name": "run_id",
            "dataType": "string",
            "sourceColumn": "run_id",
            "summarizeBy": "none"
          },
          {
            "name": "interval_status",
            "dataType": "string",
            "sourceColumn": "interval_status",
            "summarizeBy": "none"
          },
          {
            "name": "consumption_liters",
            "dataType": "int64",
            "sourceColumn": "consumption_liters",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fct_consumption",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = Csv.Document(File.Contents(DataFolder & \"/fct_consumption.csv\"), [Delimiter=\",\", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "  Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "  EmptyToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "  Typed = Table.TransformColumnTypes(EmptyToNull, {{\"reading_id\", type text}, {\"meter_id\", type text}, {\"reading_date\", type date}, {\"counter_liters\", Int64.Type}, {\"previous_counter_liters\", Int64.Type}, {\"interval_days\", Int64.Type}, {\"run_id\", type text}, {\"interval_status\", type text}, {\"consumption_liters\", Int64.Type}}, \"en-US\")",
                "in",
                "  Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Consumption m3",
            "expression": "DIVIDE(SUM(fct_consumption[consumption_liters]), 1000)",
            "formatString": "#,0.0",
            "description": "Synthetic demonstration; see docs/metric-definitions.md for grain and limitations."
          },
          {
            "name": "Valid interval share",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(fct_consumption), fct_consumption[interval_status] = \"valid\"), COUNTROWS(fct_consumption))",
            "formatString": "0.00%",
            "description": "Synthetic demonstration; see docs/metric-definitions.md for grain and limitations."
          },
          {
            "name": "Reading count",
            "expression": "COUNTROWS(fct_consumption)",
            "formatString": "#,0",
            "description": "Synthetic demonstration; see docs/metric-definitions.md for grain and limitations."
          }
        ]
      },
      {
        "name": "fct_billing",
        "columns": [
          {
            "name": "invoice_id",
            "dataType": "string",
            "sourceColumn": "invoice_id",
