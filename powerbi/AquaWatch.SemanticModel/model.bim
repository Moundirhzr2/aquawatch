        "partitions": [
          {
            "name": "fct_imports",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = Csv.Document(File.Contents(DataFolder & \"/fct_imports.csv\"), [Delimiter=\",\", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "  Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "  EmptyToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "  Typed = Table.TransformColumnTypes(EmptyToNull, {{\"run_id\", type text}, {\"file_name\", type text}, {\"started_at\", type datetime}, {\"status\", type text}, {\"accepted\", Int64.Type}, {\"rejected\", Int64.Type}, {\"duplicates\", Int64.Type}}, \"en-US\")",
                "in",
                "  Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Accepted rows",
            "expression": "SUM(fct_imports[accepted])",
            "formatString": "#,0",
            "description": "Synthetic demonstration; see docs/metric-definitions.md for grain and limitations."
          },
          {
            "name": "Quarantined rows",
            "expression": "SUM(fct_imports[rejected])",
            "formatString": "#,0",
            "description": "Synthetic demonstration; see docs/metric-definitions.md for grain and limitations."
          },
          {
            "name": "Acceptance rate",
            "expression": "DIVIDE(SUM(fct_imports[accepted]), SUM(fct_imports[accepted]) + SUM(fct_imports[rejected]))",
            "formatString": "0.00%",
            "description": "Synthetic demonstration; see docs/metric-definitions.md for grain and limitations."
          }
        ]
      },
